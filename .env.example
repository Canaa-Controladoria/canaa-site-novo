# Copie para .env.local e preencha. Nada aqui é commitado (exceto este exemplo).

# --- Sanity (blog) ---
# projectId e dataset da conta Sanity da Canaã (criados em https://sanity.io/manage).
# Enquanto a conta da Canaã não existir, use o projeto temporário do desenvolvedor.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-06

# Tokens de API (sanity.io/manage -> API -> Tokens). NUNCA commitar.
# READ: role Viewer (rascunhos/preview).  WRITE: role Editor (usado só pelo seed).
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# --- Formulários / e-mail ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO_EMAIL=

# --- Site ---
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
